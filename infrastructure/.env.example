COMPOSE_PROJECT_NAME=parking-tttn-dev
TZ=Asia/Ho_Chi_Minh
APP_IMAGE_TAG=local

# Development mode: account provisioned on the Laragon MySQL server.
AI_PARKING_DB_HOST=host.docker.internal
AI_PARKING_DB_PORT=3306
AI_PARKING_DB_USER=parking_app
AI_PARKING_DB_PASSWORD=replace_with_a_local_secret
AI_PARKING_DB_NAME=ai_parking_system

# Standalone Docker MySQL.
MYSQL_DATABASE=ai_parking_system
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_secret
MYSQL_USER=parking_app
MYSQL_PASSWORD=replace_with_a_local_secret
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081

REDIS_PASSWORD=replace_with_a_local_secret
REDIS_PORT=6380
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=replace_with_a_local_secret
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_ERLANG_COOKIE=replace_with_a_random_cookie

# Used only by standalone mode, and only when the account does not exist.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_local_secret
BOOTSTRAP_ADMIN_FULL_NAME=Quan tri vien he thong

JWT_SECRET=replace_with_a_random_jwt_secret

AUTH_PORT=8001
AI_DETECTION_PORT=8002
PARKING_BILLING_PORT=8003
REPORTING_PORT=8004
STREAMLIT_PORT=8501

MYSQL_IMAGE_TAG=8.4.11
PHPMYADMIN_IMAGE_TAG=5.2.3-apache
REDIS_IMAGE_TAG=7.4.11-alpine
RABBITMQ_IMAGE_TAG=4.3.5-management

PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.5.1
TORCHVISION_VERSION=0.20.1
AIO_PIKA_VERSION=9.5.6
REDIS_PY_VERSION=5.2.1
PYJWT_VERSION=2.10.1
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
